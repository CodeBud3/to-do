#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Get list of changed files
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=AM | grep '^frontend/.*\.\(tsx\|jsx\|ts\|js\)$' || true)

# If no relevant files changed, skip tests
if [ -z "$CHANGED_FILES" ]; then
  echo "No frontend .tsx or .js files changed. Skipping tests..."
  exit 0
fi

echo "Running Vitest on frontend changes..."
cd frontend || exit 1
npx vitest --run --passWithNoTests
